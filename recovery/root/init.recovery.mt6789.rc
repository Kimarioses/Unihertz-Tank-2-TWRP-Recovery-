#import /init.recovery.trustkernel.rc
import /init.recovery.nano.rc
import /init.recovery.trustkernel.rc
#import /vendor/etc/init/android.hardware.gatekeeper@1.0-service.rc
# trustkernel tee patch start
#import /vendor/etc/init/android.hardware.security.keymint-service.trustkernel.rc
# trustkernel tee patch end
#import /init.recovery.project.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop crypto.ready 1

on fs && property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on fs
    install_keyring
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/by-name

# We need vold early for metadata encryption
on early-fs
    start vold

on late-fs
    # Mount RW partitions which need run fsck
    mount_all /first_stage_ramdisk/fstab.mt6789 --late

on post-fs
    start boot-hal-1-2

    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b

on boot
    start mtk.plpath.utils.link

on property:persist.vendor.mtk.pl_lnk=1
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b

# FSTAB_RAW2(lk2,bootloader2) of fstab.in.emmc, but without bootloader2 mount point
    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2

# Fix ro.vendor.mtk_ufs_support remove issue of recovery mode
on property:vendor.mtk.boot0_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot0

on property:vendor.mtk.boot1_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot1

import /init.recovery.microtrust.rc

on init
    mkdir /mnt/vendor/persist 0700 root root
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist

on post-fs
    write /proc/bootprof "INIT:post-fs"

    # Support legacy paths
    symlink /sdcard /storage/sdcard0

    chown system system /mnt/vendor/protect_f
    chmod 0770 /mnt/vendor/protect_f

    chown system system /mnt/vendor/protect_s
    chmod 0770 /mnt/vendor/protect_s
    chown root log /proc/ccci_sib

    # [AGOLD][Zhangyongjiang][ADD] BST ALGO@{
    #add by Jim.cai@bst.ai for persist permission
    restorecon_recursive /mnt/vendor/persist
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist

    chown system system /mnt/vendor/nvcfg
    chmod 0771 /mnt/vendor/nvcfg
    restorecon_recursive /mnt/vendor/nvcfg

    # create basic filesystem structure
    # We chown/chmod /mnt/vendor/nvdata again so because mount is run as root + defaults
    chown root system /mnt/vendor/nvdata
    chmod 0771 /mnt/vendor/nvdata
    mkdir /mnt/vendor/nvdata/media 0771 media audio

    #Create cct mount point
    mkdir /mnt/vendor/cct
    chown root system /mnt/vendor/cct
    chmod 0771 /mnt/vendor/cct

    #Create flash folder
    mkdir /data/vendor/flash
    chown root system /data/vendor/flash
    chmod 0771 /data/vendor/flash

    #Create shading mount point
    mkdir /data/vendor/shading
    chown root system /data/vendor/shading
    chmod 0771 /data/vendor/shading

    #Create shading_otp mount point
    mkdir /data/vendor/shading_otp
    chown root system /data/vendor/shading_otp
    chmod 0771 /data/vendor/shading_otp

    #Create NDD mount point
    mkdir /data/vendor/camera_dump
    chown root system /data/vendor/camera_dump
    chmod 0771 /data/vendor/camera_dump

    #Create Camera Dip Debug Folder
    mkdir /data/vendor/dipdebug
    chown root system /data/vendor/dipdebug
    chmod 0771 /data/vendor/dipdebug

    #Create flicker mount point
    mkdir /data/vendor/flicker
    chown root system /data/vendor/flicker
    chmod 0771 /data/vendor/flicker

    # Set SELinux security contexts on upgrade or policy update.
    restorecon_recursive /mnt/vendor/nvdata

    mkdir /mnt/vendor/cct
    mkdir /mnt/vendor/nvcfg
    mkdir /mnt/vendor/nvdata
    mkdir /mnt/vendor/persist
    mkdir /mnt/vendor/protect_f
    mkdir /mnt/vendor/protect_s
    mkdir /mnt/runtime/default
    mkdir /system_ext/apex
    mkdir /storage/sdcard0

    mkdir /mnt/vendor/nvcfg/fg
    mkdir /mnt/vendor/nvcfg/fg/old_fg_data
    mkdir /mnt/vendor/nvcfg/fg/car_tune_value

    chown system system /mnt/vendor/nvcfg/fg
    chown system system /mnt/vendor/nvcfg/fg/old_fg_data
    chown system system /mnt/vendor/nvcfg/fg/car_tune_value

    # Modem related device nodes
    mkdir /mnt/vendor/nvdata/md  0770 root system
    symlink /mnt/vendor/nvcfg /dev/block/by-name/nvcfg
    symlink /mnt/vendor/persist /dev/block/by-name/persist
    symlink /mnt/vendor/nvdata /dev/block/by-name/nvdata
    symlink /mnt/vendor/protect_f /dev/block/by-name/protect1
    symlink /mnt/vendor/protect_s /dev/block/by-name/protect2
    
    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg defaults defaults
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist defaults defaults
    mount ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata defaults defaults
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f defaults defaults
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s defaults defaults

    mount ext4 /metadata /dev/block/by-name/metadata
    mount ext4 /vendor_dlkm_imge /dev/block/mapper/vendor_dlkm_a
    mount ext4 /odm_dlkm /dev/block/mapper/odm_dlkm_a

    restorecon -R /mnt/vendor/nvcfg/lost+found
    restorecon -R /mnt/vendor/persist/lost+found
    restorecon -R /mnt/vendor/nvdata/lost+found
    restorecon -R /mnt/vendor/protect_f/lost+found
    restorecon -R /mnt/vendor/protect_s/lost+found

    symlink /system_root/system/linkerconfig /linkerconfig
    symlink /system_ext/apex /apex
    symlink /system_root/system_ext/apex /apex
    symlink /system_root/system/product /product
    symlink /system_root/system/vendor /vendor

    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg rw
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw
    mount ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata rw
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f rw
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s rw

    umount /vendor
    mount /vendor

on fs
    install_keyring
    setprop crypto.ready 1

on fs
    start hwservicemanager
    start servicemanager

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-trustkernel /vendor/bin/hw/android.hardware.security.keymint-service.trustkernel
    class early_hal
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    user nobody
    seclabel u:r:recovery:s0

#service vendor.keymint-trustkernel /vendor/bin/hw/android.hardware.security.keymint-service.trustkernel
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

on property:crypto.ready=1
    start vendor.keymint-trustkernel

on property:hwservicemanager.ready=true
    start teed
    start vendor.gatekeeper-1-0
    start vendor.keymint-trustkernel
    start keymaster_attestation-1-1

on property:ro.crypto.state=unsupported
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel
    stop keymaster_attestation-1-1

on property:ro.crypto.state=unencrypted
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel

on property:twrp.decrypt.done=true
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel
    stop keymaster_attestation-1-1

on property:crypto.ready=0
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel
    stop keymaster_attestation-1-1

on post-fs-data
    mkdir /data/vendor_de 0770 system system
    mkdir /data/vendor_de/0 0770 system system
    mkdir /data/vendor/hardware 0771 root root

    start health-hal-2-1
    setprop sys.usb.config adb

 on boot
    mkdir /mnt/vendor/persist
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw
    mkdir /mnt/vendor/protect_f
    mkdir /mnt/vendor/protect_s
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f rw
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s rw
    mkdir /mnt/vendor/persist/t6_twrp
    mkdir /mnt/vendor/protect_f/tee_twrp
    exec u:r:recovery:s0 system -- /vendor/bin/trustkernel.twrp.sh

    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg ro
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist ro
    mount ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata ro
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f ro
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s ro
